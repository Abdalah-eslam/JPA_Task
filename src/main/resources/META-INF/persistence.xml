<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">


    <persistence-unit name="JPA_Task" transaction-type="RESOURCE_LOCAL">
        <provider>
            org.hibernate.jpa.HibernatePersistenceProvider
        </provider>
        <class>org.Task.Models.Author</class>
        <class>org.Task.Models.Book</class>
        <class>org.Task.Models.Publisher</class>
        <class>org.Task.Models.Category</class>
        <class>org.Task.Models.Person</class>
        <class>org.Task.Models.Employee</class>
        <class>org.Task.Models.Customer</class>

        <properties>
            <property
                    name="jakarta.persistence.jdbc.url"
                    value="jdbc:mysql://localhost:3306/jpa_task"/>

            <property
                    name="jakarta.persistence.jdbc.driver"
                    value="com.mysql.cj.jdbc.Driver"/>

            <property
                    name="jakarta.persistence.jdbc.user"
                    value="root"/>

            <property
                    name="jakarta.persistence.jdbc.password"
                    value="abdalah"/>

            <property
                    name="hibernate.dialect"
                    value="org.hibernate.dialect.MySQLDialect"/>

            <property
                    name="hibernate.hbm2ddl.auto"
                    value="validate"/>

            <property
                    name="hibernate.show_sql"
                    value="true"/>
        </properties>
    </persistence-unit>
</persistence>
